{
  "name": "mathgenius-free",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node --experimental-strip-types scripts/generate-seo.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:ui": "vitest run",
    "test:viewport": "playwright test --config playwright.config.ts",
    "seo:generate": "node --experimental-strip-types scripts/generate-seo.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.0",
    "vitest": "^4.0.14",
    "@testing-library/react": "^16.3.0",
    "jsdom": "^27.2.0",
    "@testing-library/dom": "^10.4.1",
    "@playwright/test": "^1.57.0",
    "vite-plugin-pwa": "^1.2.0"
  },
  "description": "초등 1~6학년 수학천재 무료 교구 GitHub Pages"
}
