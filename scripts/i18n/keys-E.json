[["도형의 곧은 변과 주황색 꼭짓점을 하나씩 눌러 세어 보세요. 삼각형은 ⟨0⟩개씩, 사각형은 ⟨1⟩개씩이에요.", "app:1-2-3"], ["주황색 꼭짓점을 끌어 모양을 바꿔도 변과 꼭짓점의 개수가 그대로인지 확인해 보세요. ⟨0⟩° 같은 각도 재기는 ⟨1⟩학년에서 배워요.", "app:1-2-3"], ["둘레 탭을 선택하고 윗변, 오른쪽 변, 아랫변, 왼쪽 변을 차례로 터치해 보세요. ⟨0⟩cm+⟨1⟩cm+⟨2⟩cm+⟨3⟩cm=⟨4⟩cm로 바깥쪽 경계 길이를 구해요.", "app:5-1-6"], ["같은 직사각형도 넓이는 안에 들어간 칸 수(⟨0⟩×⟨1⟩=⟨2⟩cm²), 둘레는 바깥 네 변의 길이(⟨3⟩cm)예요. 주황 모서리를 움직이며 둘의 차이를 다시 비교해 보세요.", "app:5-1-6"], ["위의 ‘모서리 ⟨0⟩개’와 ‘꼭짓점 ⟨1⟩개’ 버튼을 눌러 관찰 모드를 바꿔 보세요. 모서리는 두 면이 만나는 선, 꼭짓점은 세 모서리가 만나는 점이에요.", "app:5-2-5"], ["‘전개도 펼치기’를 눌러 평면의 여섯 면과 입체의 여섯 면을 짝지어 보세요. 정육면체로 바꾸면 여섯 면 모두 같은 정사각형이 돼요.", "app:5-2-5"], ["많은 친구의 사탕을 하나 선택해 적은 친구에게 옮겨 주세요. 사탕을 옮겨도 전체 합계는 그대로예요. ▶ 사탕 한 개 고르게 옮기기 버튼으로도 체험할 수 있어요.", "app:5-2-6"], ["모두 비슷해지면 남은 사탕까지 똑같이 나눠 보세요. 전체 ⟨0⟩개를 ⟨1⟩명에게 나눈 수가 평균이에요. ⟨2⟩으로 나누어떨어지지 않으면 사탕을 세 조각으로 나눠 줄 수도 있어요.", "app:5-2-6"], ["하나", "motion:count9"], ["둘", "motion:count9"], ["셋", "motion:count9"], ["다섯", "motion:count9"], ["여섯", "motion:count9"], ["일곱", "motion:count9"], ["상자 모양", "motion:shapes3d"], ["둥근기둥 모양", "motion:shapes3d"], ["공 모양", "motion:shapes3d"], ["한쪽으로 굴러가요", "motion:shapes3d"], ["굴러가지 않아요", "motion:shapes3d"], ["변 ⟨0⟩개", "motion:shapes"], ["굽은 선", "motion:shapes"], ["파란색", "motion:classify"], ["주황색", "motion:classify"], ["동그라미", "motion:classify"], ["= ⟨0⟩시간", "motion:lengthtime"], ["⟨0⟩개씩 ⟨1⟩묶음", "motion:divide"], ["⟨0⟩분 = ⟨1⟩시간", "motion:timecalc"], ["⟨0⟩시 ⟨1⟩분 − ⟨2⟩분", "motion:timecalc"], ["남은 ⟨0⟩개", "motion:divremainder"], ["중심", "motion:circle"], ["반지름은", "motion:circle"], ["지름 = 반지름 × ⟨0⟩", "motion:circle"], ["사과", "motion:organize"], ["배", "motion:organize"], ["= ⟨0⟩명", "motion:organize"], ["만", "motion:bigplace"], ["십만", "motion:bigplace"], ["백만", "motion:bigplace"], ["천만", "motion:bigplace"], ["⟨0⟩만 ⟨1⟩", "motion:bigplace"], ["삼천오백이십칠만 천팔백사십육", "motion:bigplace"], ["기준선", "motion:transform"], ["여름", "motion:bargraph"], ["같은 자리끼리", "motion:decimaladd"], ["육각형", "motion:polygons"], ["⟨0⟩의 약수", "motion:gcdlcm"], ["⟨0⟩의 배수", "motion:gcdlcm"], ["성냥개비", "motion:correspond"], ["크기가 같아요", "motion:reduce"], ["밑변 × 높이", "motion:area"], ["⟨0⟩원", "motion:rounddown"], ["옆", "motion:nets"], ["나", "motion:average"], ["다", "motion:average"], ["판", "motion:naturalfraction"], ["삼각기둥", "motion:polyhedra"], ["사각기둥", "motion:polyhedra"], ["오각기둥", "motion:polyhedra"], ["면 ⟨0⟩ + ⟨1⟩ = ⟨2⟩", "motion:polyhedra"], ["사각뿔", "motion:pyramid"], ["비교하는 양 ⟨0⟩", "motion:ratio"], ["기준량 ⟨0⟩", "motion:ratio"], ["비율", "motion:ratio"], ["⟨0⟩칸 중 ⟨1⟩칸", "motion:ratio"], ["축구 ⟨0⟩%", "motion:circlegraph"], ["축구", "motion:bandgraph"], ["농구", "motion:bandgraph"], ["× 높이 ⟨0⟩", "motion:volume"], ["⟨0⟩층 ⟨1⟩개", "motion:stacking"], ["모두 ⟨0⟩개", "motion:stacking"], ["= ⟨0⟩개", "motion:stacking"], ["앞", "motion:solidviews"], ["위", "motion:solidviews"], ["외항", "motion:proportion"], ["내항", "motion:proportion"], ["반지름 × ⟨0⟩", "motion:circlearea"], ["지름 × ⟨0⟩", "motion:circumference"], ["⟨0⟩ 초", "lab:lengthtime"], ["= ⟨0⟩초", "lab:lengthtime"], ["지름 ⟨0⟩개", "lab:circle"], ["≈ ⟨0⟩개", "lab:average"], ["한 명에게 ⟨0⟩개씩 주면 ⟨1⟩개를 사용하고 ⟨2⟩개가 남아요. 남은 것까지 똑같이 나누려면 각각 ⟨3⟩개를 ⟨4⟩등분한 만큼 더 받아요.", "lab:average"], ["각자 ⟨0⟩개씩 먼저 나누고 남은 ⟨1⟩개를 세 친구에게 똑같이 ⟨2⟩등분했어요.", "lab:average"], ["첫 번째 친구 ⟨0⟩개와 ⟨1⟩분의 ⟨2⟩개", "lab:average"], ["두 번째 친구 ⟨0⟩개와 ⟨1⟩분의 ⟨2⟩개", "lab:average"], ["세 번째 친구 ⟨0⟩개와 ⟨1⟩분의 ⟨2⟩개", "lab:average"], ["모두 ⟨0⟩개씩 같아졌어요! 이 수가 평균이에요.", "lab:average"], ["가", "manual"]]